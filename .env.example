# ============================================================================
# إعدادات خوادم الخرائط والملاحة في الإنتاج (Production Maps & Routing Config)
# ============================================================================
# عند رفع السيرفر الخاص بك، قم بنسخ هذا الملف إلى .env.production وتعديل الروابط
# لتشير إلى الدومين الخاص بسيرفرك (بدون الحاجة لتعديل سطر واحد في الكود).

# 1. رابط محرك المسارات والملاحة البرية (Valhalla Routing Engine - Egypt)
# الافتراضي في التطوير: https://valhalla1.openstreetmap.de
# في الإنتاج (مثال): https://routing.mo7amek.com
VITE_VALHALLA_URL=https://valhalla1.openstreetmap.de

# 2. رابط محرك المسارات الاحتياطي (OSRM Fallback Engine - اختياري)
# الافتراضي في التطوير: https://routing.openstreetmap.de/routed-car
VITE_OSRM_URL=https://routing.openstreetmap.de/routed-car

# 3. رابط خادم صور/بلاطات الخريطة (Map Tiles CDN / Proxy)
# الافتراضي في التطوير: https://tile.openstreetmap.org/{z}/{x}/{y}.png
# في الإنتاج (مثال): https://tiles.mo7amek.com/{z}/{x}/{y}.png
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

