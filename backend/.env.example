PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# Database
DATABASE_URL=postgresql://mylawyer_user:MyLawyer_SecurePass_2026!@127.0.0.1:5432/mylawyer_prod

# JWT Secrets (Will be overridden by production env on server)
JWT_SECRET=super_secret_jwt_access_key_mylawyer_2026_prod_minimum_32_characters
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_mylawyer_2026_prod_minimum_32_chars

# Storage Paths
PUBLIC_STORAGE_PATH=/var/www/mylawyer/storage/public
PRIVATE_STORAGE_PATH=/var/www/mylawyer/storage/private_docs

# Email / SMTP
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURE=false
EMAIL_FROM="MyLawyer <noreply@mylawyer.app>"

# CORS Allowed Origins
CORS_ORIGIN=*

